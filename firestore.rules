rules_version = '2';

// ColomboPal — Firestore security rules.
//
// Roles come from users/{uid}.role ("user" | "admin"). Users can create
// their own profile ONLY with role "user" and can never change a role, so
// admin accounts can only be made in the Firebase console.
//
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- User profiles ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Registration (AuthService.register / fetchProfile).
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);

      // Own name/email may change; the role never can from the client.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ---- Condition reports ----
    match /condition_reports/{reportId} {
      // Owners see their own reports; admins see everything.
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      // New reports belong to the submitter and start under review.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'underReview';

      // Only admins review, and only these three fields.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'adminComment', 'updatedAt']);

      // Admins may delete any report; owners may retract their own.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
